# Contoh .env produksi untuk ~5.000 pengguna (1 server aplikasi + PostgreSQL + Redis).
APP_NAME=SIBIS
APP_ENV=production
APP_KEY=                      # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://sibis.kampus.ac.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sibis
DB_USERNAME=sibis
DB_PASSWORD=                  # kata sandi kuat

# Redis untuk sesi, cache (termasuk batas laju), dan antrean.
REDIS_CLIENT=phpredis         # pecl/apt: php-redis. Bila tidak ada: predis (composer require predis/predis)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=smtp.kampus.ac.id
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="sibis@kampus.ac.id"
MAIL_FROM_NAME="SIBIS"

SIBIS_PASSWORD_AWAL=          # WAJIB diisi, acak dan panjang; dipakai impor dan reset akun
SIBIS_CACHE_DETIK=60
SIBIS_PG_TRIGRAM=true
# SIBIS_DISK_DRAF=s3          # bila draf disimpan di object storage (atur disk s3 di config/filesystems.php)
